pipeline {
    agent any
    
    stages {

        stage ('Clonar el código del repositorio') {
            steps {
                echo "Pipeline para el ejercicio Jenkins 1, me traigo el código de mi repo de git"
                git 'https://github.com/daniel-unir/helloworld.git'
                sh 'ls -lah'
                echo '$WORKSPACE'
            }
        }

        stage ('Tests') {

            parallel {

                stage ('Unit') {
                    steps {
                        sh 'export PYTHONPATH=$WORKSPACE && pytest --junitxml=result-unit.xml test/unit'
                    }
                }

                stage ('Service') {
                    steps {
                        catchError (buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                echo 'Levantamos el API de la calculadora con Flask'
                                sh 'export FLASK_APP=$WORKSPACE/app/api.py && flask run &'
                                echo 'Levantamos el API de Wiremock'
                                sh 'java -jar /home/daniel/unir/wiremock/wiremock-standalone-3.13.0.jar --port 9090 --root-dir /home/daniel/unir/wiremock &'
                                sh 'sleep 5s'
                                sh 'export PYTHONPATH=$WORKSPACE && pytest --junitxml=result-rest.xml test/rest'
                        }
                    }
                }
            }
        }

        stage ('Cobertura') {
            steps {
                catchError (buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    sh 'python3 -m coverage run --source=app --omit=app/__init__.py,app/api.py --branch -m pytest test/unit'
                    sh 'python3 -m coverage xml'
                    recordCoverage(tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                        qualityGates: [
                            [threshold: 95.0, metric: 'LINE', baseline: 'PROJECT', unstable: true],
                            [threshold: 85.0, metric: 'LINE', baseline: 'PROJECT', criticality: 'FAILURE'],
                            [threshold: 90.0, metric: 'BRANCH', baseline: 'PROJECT', unstable: true],
                            [threshold: 80.0, metric: 'BRANCH', baseline: 'PROJECT', criticality: 'FAILURE']])
                }
            }
        }
        stage ('Pruebas estáticas') {
            steps {
                sh 'python3 -m flake8 --format=pylint --exit-zero app > flake8.out'
                recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                qualityGates: [[threshold:8, type: 'TOTAL', unstable: true],
                [threshold: 10, type: 'TOTAL', unstable: false]]
            }
        }
        stage ('Pruebas de seguridad') {
            steps {
                sh 'python3 -m bandit -r app -f xml -o bandit.xml'
                recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.xml')],
                qualityGates: [[threshold:2, type: 'TOTAL', unstable: true],
                [threshold: 4, type: 'TOTAL', unstable: false]]
            }
        }
        stage ('Pruebas de rendimiento') {
            steps {
                sh '''
                /home/daniel/unir/jmeter/apache-jmeter-5.6.3/bin/jmeter -f -n -t test/jmeter/flask.jmx -l CP1.2.jtl
                '''
                perfReport sourceDataFiles: 'CP1.2.jtl'
            }
        }
        stage ('Results') {
            steps {
                junit '*.xml'
            }
        }
    }
}
